<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 通信参数：网络类型 / 信号强度 / 小区信息需要电话状态；小区信息在 Android 10+ 还需要位置权限 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 机型库在线更新：没有 INTERNET 权限时所有网络请求都会被系统直接拒绝，
         这正是 0.6 及以前「首页更新按钮点了没反应」的原因 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 硬件测试：扬声器/麦克风/摄像头 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 硬件测试：振动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 更新前先判断有没有网络，省得用户对着「正在检查…」白等 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".XyzInfoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XyzInfo">

        <activity
            android:name=".MainActivity"
            android:exported="true" />
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 各硬件检测页面：统一放在 ui 包下，按功能分子包组织 -->
        <activity android:name=".ui.soc.SocInfoActivity" />
        <activity android:name=".ui.ram.RamInfoActivity" />
        <activity android:name=".ui.screen.ScreenInfoActivity" />
        <activity android:name=".ui.battery.BatteryInfoActivity" />
        <activity android:name=".ui.sensor.SensorInfoActivity" />
        <activity android:name=".ui.system.SystemInfoActivity" />
        <activity android:name=".ui.benchmark.BenchmarkActivity" />
        <activity android:name=".ui.telephony.TelephonyInfoActivity" />
        <activity android:name=".ui.benchmark.RankingActivity" />
        <activity android:name=".ui.settings.SettingsActivity" />
        <activity android:name=".ui.gps.GpsInfoActivity" />
        <activity android:name=".ui.misc.MiscActivity" />
        <activity android:name=".ui.about.ChangelogActivity" />
        <activity android:name=".ui.env.EnvironmentCheckActivity" />
        <activity android:name=".ui.inspect.DeviceInspectActivity" />
        <activity android:name=".ui.fish.FishAiActivity" />
        <activity android:name=".ui.thermal.ThermalActivity" />
        <activity android:name=".ui.hardware.HardwareMoreActivity" />
        <activity
            android:name=".ui.hardware.ScreenTestActivity"
            android:theme="@style/Theme.XyzInfo" />
    </application>
</manifest>
