<?xml version="1.0" encoding="utf-8"?>
<!-- 打开新页面：淡入 + 轻微右移，形成「推进」层次 -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@interpolator/xyz_decelerate">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
    <translate
        android:fromXDelta="6%p"
        android:toXDelta="0" />
    <scale
        android:fromXScale="0.985"
        android:fromYScale="0.985"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>
