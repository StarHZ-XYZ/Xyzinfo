<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页：外观开关 + 跑分选项 + 数据更新 + 关于 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="36dp">

        <TextView
            style="@style/Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置" />

        <TextView
            style="@style/Text.PageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="外观、跑分与数据更新" />

        <!-- 外观 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="外观" />

                <!-- 底栏固定开启（普通高斯模糊 + 下沉），这里放一个活体预览 -->
                <com.rjy.xyz.apps.xyzinfo.ui.common.GlassBottomBar
                    android:id="@+id/glassBarPreview"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/glass_bar_height"
                    android:layout_marginTop="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAnimations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:text="丝滑动画"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="页面转场、卡片按压、数字滚动、条形图生长等全部动效；关掉更省电" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchParticles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:text="点击粒子效果"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="每次点击从指尖炸开一簇粒子与一圈波纹，盖满全屏但不影响点击" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFollowSystemColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:text="跟随系统主题色（莫奈取色）"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Android 12 及以上按系统壁纸生成配色，作用于按钮、开关、滑块、水波纹与系统栏；关掉保持应用自己的青绿" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDeepSeekTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="46dp"
                    android:text="大肥鱼主题"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="不改配色，只在每个页面的角落摆一条可爱的大肥鱼（轻微浮动，不挡内容也不吃点击）" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="深色模式" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/layoutDarkModeChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSeason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:text="飘落特效（总开关）"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSeasonHint"
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="总开关：四季氛围（春花瓣 / 夏阳光 / 秋枫叶 / 冬雪花）和节日特效（灯笼 / 爱心 / 月饼…）都归它管，关掉则一律不出现" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/layoutSeasonChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSeasonGravity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="46dp"
                    android:text="跟随重力飘落"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSeasonGravityHint"
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开启后雪花 / 枫叶 / 花瓣会顺着设备倾斜的方向斜着落；节日特效（灯笼 / 爱心 / 月饼 / 五角星…）也跟随同一个开关" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHoliday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="46dp"
                    android:text="节日彩蛋特效"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvHolidayHint"
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="春节、元宵、端午、七夕、中秋、国庆、元旦、情人节、建军节、劳动节、儿童节、圣诞节当天，进入软件会换成节日特效并弹一条祝福（默认开启）" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHomeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:text="主页宫格样式"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打开后主页的功能模块排成两列宫格，关掉恢复一列列表" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 必应每日壁纸 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="必应每日壁纸" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="46dp"
                    android:text="把必应每日图作为软件背景"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvWallpaperInfo"
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="正在读取壁纸信息…" />

                <TextView
                    android:id="@+id/tvScrimValue"
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="蒙版浓度：72%（越高越清楚，越低越能看到壁纸）" />

                <SeekBar
                    android:id="@+id/seekScrim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="47"
                    android:progress="27" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWallpaperNext"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="换一张（取往期必应图）"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 跑分 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="性能测试" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDeepBenchmark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="46dp"
                    android:text="深度跑分（约 3 分钟）"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="标准模式约 1 分半；深度模式把每个阶段拉长 2.6 倍，能看出更明显的发热降频" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearBenchmark"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="清除本机跑分记录"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/stroke" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 数据 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据更新" />

                <TextView
                    android:id="@+id/tvDataStatus"
                    style="@style/Text.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_row_panel"
                    android:padding="14dp"
                    android:text="数据来源：正在读取…" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:text="检查机型库更新"
                    android:textColor="@color/text_on_accent"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetData"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="恢复内置机型库"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/stroke" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="机型库把设备代号 / 型号翻译成上市机型名；更新会从项目仓库下载最新名单，失败时可随时恢复内置数据" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 关于 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关于" />

                <TextView
                    android:id="@+id/tvAbout"
                    style="@style/Text.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_row_panel"
                    android:padding="14dp"
                    android:text="XYZ-Devinfo 设备检测" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGithub"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="打开 GitHub 仓库（StarHZ-XYZ/Xyzinfo）"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenChangelog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="更新日志 / 后续版本敬请期待"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="?attr/colorPrimary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider" />

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="大肥鱼助手（DeepSeek）" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="填 API Key 可直连官方接口；也可以只用官方免费版网页（需要登录）" />

                <EditText
                    android:id="@+id/etDeepSeekKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_code_panel"
                    android:hint="sk-…（留空表示不使用直连）"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveDeepSeekKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:text="保存 Key"
                    android:textColor="@color/text_on_accent"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAiModeApi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_filter"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="API Key 直连"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/chipAiModeWeb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_filter"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="官方免费版（需登录）"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAiModeHint"
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="当前：官方免费版" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
