<?xml version="1.0" encoding="utf-8"?>
<!-- 系统信息详情页 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/tvSystemTitle"
            style="@style/Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="系统详细信息" />

        <TextView
            android:id="@+id/tvSystemSubTitle"
            style="@style/Text.PageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="版本、内核、设备标识与环境总览" />

        <!-- 系统 UI / ROM -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统 UI / ROM" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="厂商定制系统类型与版本" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_row_panel"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvRomName"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="系统类型：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvRomVersion"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="系统版本号：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvDisplayId"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Build 显示 ID：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvBuildType"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="构建类型：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvRomSource"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="识别依据：—" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统版本" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Android 版本、补丁与内核" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_row_panel"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvAndroidVersion"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Android 版本：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvApiLevel"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="API 等级：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvBuildId"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Build ID：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvSecurityPatch"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="安全补丁：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvKernelVersion"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Linux 内核：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvBootloader"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Bootloader：—" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设备标识" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Build 字段与指纹" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_row_panel"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvBrand"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="品牌：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvManufacturer"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="制造商：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvModel"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="型号：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvDevice"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="设备代号：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvProduct"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Product：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvBoard"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Board：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvHardware"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Hardware：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvFingerprint"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Fingerprint：—" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="环境与系统状态" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="语言、时区、存储与 Root 状态" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_row_panel"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvAbi"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="ABI 列表：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvLanguage"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="系统语言：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvTimezone"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="时区：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="当前时间：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvRamSummary"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="运行内存概览：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvInternalStorage"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="系统分区存储：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvDataStorage"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="数据分区存储：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvRootStatus"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Root 状态：—" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tvTrebleStatus"
                        style="@style/Text.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:text="Project Treble：—" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="原始信息" />

                <TextView
                    style="@style/Text.SectionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="用于辅助识别与排查" />

                <TextView
                    android:id="@+id/tvRawSystemInfo"
                    style="@style/Text.RawBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_code_panel"
                    android:padding="14dp"
                    android:text="原始系统信息：" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
