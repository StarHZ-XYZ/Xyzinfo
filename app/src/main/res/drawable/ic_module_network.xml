<?xml version="1.0" encoding="utf-8"?>
<!-- 模块图标：网络测速（仪表盘 + 指针，一眼可辨「测速」） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 表盘外圈：两段圆弧拼成整圆，再用 evenOdd 挖出内圈 -->
    <path
        android:fillColor="?attr/colorPrimary"
        android:fillType="evenOdd"
        android:pathData="M12,2.6 A9.4,9.4 0 1,1 11.99,2.6 Z M12,5 A7,7 0 1,0 12.01,5 Z" />
    <!-- 指针：从圆心指向右上，表示「速度」 -->
    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M11.1,12.9 L16.4,7.3 L17.6,8.5 L12.4,14.1 Z" />
    <!-- 中心轴 -->
    <path
        android:fillColor="?attr/colorPrimary"
        android:pathData="M12,12 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0" />
</vector>
