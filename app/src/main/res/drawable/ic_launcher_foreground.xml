<!--
  XYZ-Devinfo 图标（第三版）。

  这一版按"以 X 为主体、齿轮做点缀"重新构图：
  · 主体是一枚粗壮圆头的白色 X（项目名 XYZ 的首字母），
    整体只占画布中间约 46×46（上一版占 76×76，所以上一版显得太满太大）；
  · 右下角一枚薄荷绿的**小齿轮**叠在 X 的末端，作为"硬件/参数"的点缀；
  · 右上角一颗小星芒，呼应原图标。

  底色是青蓝渐变（左上青绿 → 右下深蓝）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主体 X：两条粗圆头斜杠 -->
    <path
        android:pathData="M37,37 L67,67"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="13" />
    <path
        android:pathData="M67,37 L37,67"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="13" />

    <!-- 点缀：右下角的小齿轮（薄荷绿） -->
    <path
        android:pathData="M74,60 L74,64.5 M78.5,63 L81,60.4 M81.5,68 L85.4,68 M78.5,73 L81,75.6 M74,76 L74,80.5 M69.5,73 L67,75.6 M66.5,68 L62.6,68 M69.5,63 L67,60.4"
        android:strokeColor="#FF8BF0CE"
        android:strokeLineCap="round"
        android:strokeWidth="4.6" />
    <path
        android:fillColor="#FF8BF0CE"
        android:pathData="M74,59.5 A8.5,8.5 0 1 0 74,76.5 A8.5,8.5 0 1 0 74,59.5 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M74,65.5 A3,3 0 1 0 74,71.5 A3,3 0 1 0 74,65.5 Z" />

    <!-- 右上角小星芒 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M84,26 L85.6,31.4 L91,33 L85.6,34.6 L84,40 L82.4,34.6 L77,33 L82.4,31.4 Z" />
