<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      应用主题：只在这里定义一次。
      颜色全部指向 @color/*，深色模式由 values-night/colors.xml 自动替换，
      布尔值（状态栏图标明暗）由 values-night/bools.xml 替换。
    -->
    <style name="Base.Theme.XyzInfo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色：青绿 -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>

        <!-- 表面与文字 -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="android:colorBackground">@color/bg_bottom</item>
        <item name="android:windowBackground">@drawable/bg_main_gradient</item>

        <!-- 状态栏 / 导航栏：跟随页面背景，内容顶到状态栏后面 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/window_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_system_bars</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.XyzInfo" parent="Base.Theme.XyzInfo" />

    <!-- 页面通用文字样式 -->
    <!-- 下面这些样式名含点号，必须显式 parent="" 关掉“按前缀推断父样式” -->
    <style name="Text.PageTitle" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.PageSubtitle" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.SectionTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.SectionSubtitle" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="Text.Row" parent="">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.RawBlock" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
